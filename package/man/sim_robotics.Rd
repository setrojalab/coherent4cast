\name{sim_robotics}
\alias{sim_robotics}
\title{Synthetic robotics histories}
\description{A simulated multitype recurrent and terminal event dataset for software demonstrations. These are not real patient or machine records.}
\usage{data(sim_robotics)}
\format{A data frame of intervals for 160 units with id, start, stop, event_type, terminal, x and observed. True generating parameters and the seed are stored in the truth attribute.}
\details{The deterministic generator is supplied in data-raw/generate_synthetic.R. Domain labels illustrate a workflow rather than empirical field performance.}
\keyword{datasets}
